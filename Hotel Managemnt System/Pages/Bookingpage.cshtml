@page
@model Hotel_Managemnt_System.Pages.BookingpageModel
@{
    ViewData["Title"] = "Booking Page";
}
<link rel="stylesheet" href="css/BookingStyle.css" />
<!-- Bootstrap CSS (make sure you have it in _Layout or here) -->
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" />

<section class="container p-2 d-flex flex-column overflow-hidden" id="parentsection">

    <section id="bookingheader" class="d-flex justify-content-between align-items-center mb-3">
        <h3>Booking Records</h3>
        <div class="d-flex gap-2">
            <input type="text" id="searchBox" class="form-control form-control-sm"
                   placeholder="Search guest name..." onkeyup="filterGuests()" />

            <a class="px-3 d-block text-black" asp-page="AddBookingPage" id="AddBookingBTN">Add Booking</a>
        </div>
    </section>

    <section id="bookingtable" class="d-block w-100">
        <table class="table table-striped" id="bookingTable">
            <thead>
                <tr>
                    <th>Room Type</th>
                    <th>Guest Name</th>
                    <th>Check In</th>
                    <th>Check Out</th>
                    <th>Room Number</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var booking in Model.BookingList)
                {
                    <tr>
                        <td>@booking.RoomTypeName</td>
                        <td>@booking.GuestName</td>
                        <td>@booking.CheckIn.ToShortDateString()</td>
                        <td>@booking.CheckOut.ToShortDateString()</td>
                        <td>@booking.RoomNumber</td>
                        <td>
                            <!-- BookingId stored in data-id -->
                            <a class="text-decoration-none text-black btn btn-info" asp-page="UpdateBooking" asp-route-Bookingid="@booking.BookingId">Update</a>
                            <a class="text-decoration-none text-white btn btn-danger">Delete</a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </section>
</section>


@section Scripts{
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>



}
