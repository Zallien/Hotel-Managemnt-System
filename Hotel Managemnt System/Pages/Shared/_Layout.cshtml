<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Hotel_Managemnt_System</title>
    @* Bootstrap Link *@
    <link rel="stylesheet" href="~/lib/twitter-bootstrap/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" />
</head>
<body>
    <main class="container-fluid w-100 h-100 d-flex flex-row m-0 p-0">
        <nav id="Navbar" class="px-2 py-3">
            @await Html.PartialAsync("Components/_navbar")
        </nav>
        <div class="container overflow-hidden">
            @RenderBody()
        </div>
    </main>




    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>