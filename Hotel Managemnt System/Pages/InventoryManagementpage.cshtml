@page
@model Hotel_Managemnt_System.Pages.InventoryManagementpageModel
@{
    ViewData["Title"] = "Inventory Management";
}
<style>
    #Tableheader th {
        background-color: #1C1C1C;
        color: white;
    }
    #AddItemButton {
        background-color: #D4AF37;
        color: black;
        transition: all 300ms ease-in-out;
        cursor: pointer;
    }
    #AddItemButton:hover {
        transform: scale(1.05);
    }
    .lowstockbadge {
        background-color: yellow;
    }
</style>
<div class="table-responsive p-2 overflow-hidden">
    <h3 class="fw-bold mb-2">@ViewData["Title"]</h3>
    <div class="d-flex p-2 justify-content-end align-items-center">
        <a class="text-decoration-none text-dark px-3 py-2 fw-semibold rounded" id="AddItemButton" asp-page="AddInventoryItempage">Add Item</a>
    </div>
    <section id="Tablesection">
        <table class="table table-striped table-bordered table-hover">
            <thead id="Tableheader">
                <tr>
                    <th>Item No</th>
                    <th>Item Name</th>
                    <th>Quantity</th>
                    <th>Status</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
                @* @foreach (var item in Model.Items)
                {
                    <tr>
                        <td>@item.ItemId</td>
                        <td>@item.ItemName</td>
                        <td>@item.Category</td>
                        <td>@item.Quantity</td>
                        <td>
                            @if (item.Quantity > 50)
                            {
                                <span class="badge bg-success">In Stock</span>
                            }
                            else if (item.Quantity > 0)
                            {
                                <span class="badge lowstockbadge text-black">Low Stock</span>
                            }
                            else
                            {
                                <span class="badge bg-danger">Out of Stock</span>
                            }
                        </td>
                        <td>
                            <a asp-page="EditInventoryItempage" asp-route-ItemId="@item.ItemId" class="btn btn-sm btn-primary fw-semibold">Edit</a>
                        </td>
                    </tr>
                } *@
            </tbody>
        </table>
    </section>
</div>
