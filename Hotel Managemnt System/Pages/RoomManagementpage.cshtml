@page
@model Hotel_Managemnt_System.Pages.RoomManagementpageModel
@{
    ViewData["Title"] = "Room Management";
}
<style>
    #Tableheader th {
        background-color: #1C1C1C;
        color: white;
    }

    #AddRoomButton{
        background-color: #D4AF37;
        color: black;
        transition: all 300ms ease-in-out;
        cursor: pointer;
    }

    #AddRoomButton:hover{
        transform:scale(1.05);
    }
</style>

<div class="table-responsive p-2 overflow-hidden">
    <h3 class="fw-bold mb-2">@ViewData["Title"]</h3>
    <div class="d-flex p-2 justify-content-end align-items-center">
        <a class="text-decoration-none text-dark px-3 py-2 fw-semibold rounded" id="AddRoomButton" asp-page="AddHotelRoompage" >Add Room</a>
    </div>
    <section id="Tablesection">
        <table class="table table-striped table-bordered table-hover">
            <thead class="" id="Tableheader">
                <tr>
                    <th>Room No</th>
                    <th>Type</th>
                    <th>Status</th>
                    <th>Price</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var hotelroom in Model.Rooms)  // <-- assumes you have a Rooms list in your PageModel
                {
                    <tr>
                        <td>@hotelroom.RoomNumber</td>
                        <td>@hotelroom.RoomType</td>
                        <td>
                            @if (hotelroom.Status == "Available")
                            {
                                <span class="badge bg-success">Available</span>
                            }
                            else
                            {
                                <span class="badge bg-danger">Occupied</span>
                            }
                        </td>
                        <td>@hotelroom.PricePerNight.ToString("C")</td>
                        <td>
                            <a asp-page="/EditRoom" asp-route-id="@hotelroom.RoomId" class="btn btn-sm btn-primary fw-semibold">Edit</a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </section>
</div>