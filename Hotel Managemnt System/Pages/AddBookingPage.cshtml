@page
@model Hotel_Managemnt_System.Pages.AddBookingPageModel
@{
    ViewData["Title"] = "Add Booking";
}

<style>
    #ParentSection{
        height: 100vh;
        overflow-y: auto;
        overflow-x: hidden;
    }

    #ParentSection{
        scrollbar-width:none;
    }
</style>

<section id="ParentSection" class="p-2 w-100 pb-4">
    <h3 class="mb-3 fw-bold">Add Booking</h3>
    <form method="Post" class="form px-2">
        <h4 class="mb-2 pb-2 border-0 border-bottom">Guest Information</h4>
        <div class="mb-2">
            <label asp-for="Booking.GuestName" class="form-label">Guest Name</label>
            <input asp-for="Booking.GuestName" class="form-control" type="text" required />
            <span asp-validation-for="Booking.GuestName" class="text-danger"></span>
        </div>
        <div class="row mb-3">
            <div class="mb-2 col-6">
                <label asp-for="Booking.GuestEmail" class="form-label">Guest Email</label>
                <input asp-for="Booking.GuestEmail" class="form-control" type="text" required />
                <span asp-validation-for="Booking.GuestEmail" class="text-danger"></span>
            </div>
            <div class="mb-2 col-6">
                <label asp-for="Booking.GuestPhone" class="form-label">Guest Phone</label>
                <input asp-for="Booking.GuestPhone" class="form-control" type="text" required />
                <span asp-validation-for="Booking.GuestPhone" class="text-danger"></span>
            </div>
        </div>
        <div class="row mb-3">
            <div class="mb-2 col-6">
                <label asp-for="Booking.NumberOfGuests" class="form-label">Number of Guest</label>
                <input asp-for="Booking.NumberOfGuests" class="form-control" type="number" required />
                <span asp-validation-for="Booking.NumberOfGuests" class="text-danger"></span>
            </div>
            <div class="mb-2 col-6">
                <label asp-for="Booking.SpecialRequests" class="form-label">Special Request</label>
                <textarea asp-for="Booking.SpecialRequests" class="form-control" rows="3">

                </textarea>
                <span asp-validation-for="Booking.SpecialRequests" class="text-danger"></span>
            </div>
        </div>
        <h4 class="mb-2 pb-2 border-0 border-bottom">Room Information</h4>
        <div class="row mb-3">
            <div class="mb-2 col-6">
                <label asp-for="Booking.RoomType" class="form-label">Room Type</label>
                <select asp-for="Booking.RoomType" 
                    class="form-select" 
                    asp-items="Model.SelectRoomType" 
                    required 
                    id="RoomTypeSelect"
                    onchange="FetchavailableRooms()">

                    <option value="@Guid.Empty" selected hidden>Select RoomType</option>
                </select>
                
                <span asp-validation-for="Booking.RoomType" class="text-danger"></span>
            </div>
                <div class="mb-2 col-6">
                    <label asp-for="Booking.RoomNumber" class="form-label">Room Number</label>
                    <select asp-for="Booking.RoomNumber" 
                        class="form-select" 
                        required 
                        id="RoomNumberSelect"
                        onchange="CalculateTotalAmount()"
                        >

                    <option value="@Guid.Empty" hidden selected>Select RoomNumber</option>
                    </select>
                    
                    <span asp-validation-for="Booking.RoomNumber" class="text-danger"></span>
                </div>
        </div>
        <h4 class="mb-2 pb-2 border-0 border-bottom">Booking Date Information</h4>
        <div class="row mb-3">
            <div class="mb-2 col-6">
                <label asp-for="Booking.CheckIn" class="form-label">Check In Date</label>
                <input id="CheckinDate" asp-for="Booking.CheckIn" type="date" class="form-control" 
                    min="@DateTime.Now.ToString("yyyy-MM-dd")" max="2099-12-31" required
                       onchange="CalculateTotalAmount()" />
                <span asp-validation-for="Booking.CheckIn" class="text-danger"></span>
            </div>
            <div class="mb-2 col-6">
                <label asp-for="Booking.CheckOut" class="form-label">Check Out Date</label>
                <input id="CheckoutDate" asp-for="Booking.CheckOut" type="date" class="form-control"
                       min="@DateTime.Now" max="2099-12-31" required
                       onchange="CalculateTotalAmount()" />
                <span asp-validation-for="Booking.CheckOut" class="text-danger"></span>
            </div>
        </div>
        <h4 class="mb-2 pb-2 border-0 border-bottom">Payment Information</h4>
        <div class="row mb-3">
            <div class="mb-2 col-6">
                <label asp-for="Booking.BookingStatus" class="form-label">Booking Status</label>
                <select asp-for="Booking.BookingStatus" class="form-select" asp-items="Model.SelectBookingStatus" required>
                    <option value="" selected hidden>Select Payment Status</option>
                </select>
                <span asp-validation-for="Booking.BookingStatus" class="text-danger"></span>
            </div>
            <div class="mb-2 col-6">
                <label asp-for="Booking.CheckOut" class="form-label">Payment Status</label>
                <select asp-for="Booking.PaymentStatus" class="form-select" asp-items="Model.SelectPaymentStatus" required>
                    <option value="" selected hidden>Select Payment Status</option>
                </select>
                <span asp-validation-for="Booking.PaymentStatus" class="text-danger"></span>
            </div>
        </div>
        <div class="row mb-3">
            <div class="mb-2 col-6">
                <label asp-for="Booking.TotalAmount" class="form-label">Total Bill</label>
                <input asp-for="Booking.TotalAmount" id="TotalAmounttext" type="number" class="form-control" readonly />
                <span asp-validation-for="Booking.TotalAmount" class="text-danger"></span>
            </div>
            <div class="mb-2 col-6">
                <label asp-for="Booking.Payment" class="form-label">Total Payment</label>
                <input asp-for="Booking.Payment" type="number" class="form-control" value="0"/>
                <span asp-validation-for="Booking.Payment" class="text-danger"></span>
            </div>
        </div>
        <div class="d-flex flex-row align-items-center justify-content-end">
            <a class="text-decoration-none text-white btn btn-secondary mx-2" asp-page="Bookingpage">Back</a>
            <input type="submit" value="Add Booking" class="btn btn-primary mx-2" />
        </div>
    </form>
</section>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }

    <script>

        
        function FetchavailableRooms(){
            var roomTypeSelectvalue = document.getElementById("RoomTypeSelect").value;

            fetch('api/HotelRoom/FilterRoomAvailableByRoomTypeJSON', {
            method: 'POST',
            headers: {
                'Content-Type': 'application/json'
            },
            body: JSON.stringify(roomTypeSelectvalue) // pass the Guid
            })
            .then(response => {
                if (!response.ok) {
                    throw new Error(`HTTP error! Status: ${response.status}`);
                }
                return response.json();
            })
            .then(data => {
                console.log("Filtered rooms:", data);

                const roomNumberSelect = document.getElementById("RoomNumberSelect");
                if (!roomNumberSelect) {
                    console.error("Select element with id 'RoomNumberList' not found!");
                    return;
                }

                roomNumberSelect.innerHTML = '<option value="@Guid.Empty" hidden selected>Select RoomNumber</option>';

                data.forEach(room => {
                    const option = document.createElement("option");
                    option.value = room.roomId; // unique identifier
                    option.text = `Room ${room.roomNumber} - ${room.roomType} (${room.status})`;
                    roomNumberSelect.appendChild(option);
                });
            })

            .catch(error => {
                console.error("Error:", error);
            });

        }

        function CalculateTotalAmount(){
            console.log("Reading . . . ")
            var roomNumberValue = document.getElementById("RoomNumberSelect").value;


            console.log("Selected Room ID:", roomNumberValue);
            //Check if room selection is valid
            if (!roomNumberValue || roomNumberValue === "@Guid.Empty") {
                return;
            }

            // Get 2 Dates
            var checkInValue = document.getElementById("CheckinDate").value;
            var checkOutValue = document.getElementById("CheckoutDate").value;
            //console.log("checkin and checkout: ", checkInValue , checkOutValue);

            if (!checkInValue || !checkOutValue) {
                alert("Please select both check-in and check-out dates.");
                return;
            }

            var checkInDate = new Date(checkInValue);
            var checkOutDate = new Date(checkOutValue);

            // Ensure check-out is after check-in
            if (checkOutDate > checkInDate) {
                var timeDifference = checkOutDate.getTime() - checkInDate.getTime();
                var dayDifference = Math.floor(timeDifference / (1000 * 3600 * 24));

                fetch('api/HotelRoom/GetRoomPriceByRoomId', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json'
                },
                body: JSON.stringify(roomNumberValue) // pass the Guid
                })
                .then(response => {
                    if (!response.ok) {
                        throw new Error(`HTTP error! Status: ${response.status}`);
                    }
                    return response.json();
                })
                .then(data => {
                    //console.log(data);
                    var roomPrice = data;
                    var totalAmount = roomPrice * dayDifference;
                    //console.log("Roomprice and totalamount: ",roomPrice,totalAmount);
                    document.getElementById("TotalAmounttext").value = totalAmount;
                    
                })

                .catch(error => {
                    console.error("Error:", error);
                });





            } else {
                alert("Check-out date must be after check-in date.");
                // Convert check-in string to Date
                var checkInDateObj = new Date(checkInValue);

                // Add 1 day
                checkInDateObj.setDate(checkInDateObj.getDate() + 1);

                // Format back to yyyy-mm-dd
                var formattedCheckOut = checkInDateObj.toISOString().split('T')[0];

                // Set the checkout input value
                document.getElementById("CheckoutDate").value = formattedCheckOut;

            }

        }

    </script>
    
}